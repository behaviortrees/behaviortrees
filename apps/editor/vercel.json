{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm exec turbo run build --filter=@behaviortrees/editor --filter=@behaviortrees/site && cp -R ../site/dist/. dist/",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:route(editor|projects|settings|admin|pricing|privacy|terms|changelog)/", "destination": "/:route", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/learn/:slug.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ],
  "rewrites": [
    { "source": "/ingest/static/:path(.*)", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/ingest/:path(.*)", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/api/projects/:id", "destination": "/api/projects/[id]?id=:id" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/.well-known/openai-apps-challenge", "destination": "/api/openai-apps-challenge" },
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/:route(editor|projects|settings|admin)", "destination": "/app.html" }
  ]
}
